<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>?KAIRO BOOMBAR — CYBER CONTROL</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;500;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #07040d;
  --bg2: #0d0718;
  --panel: rgba(22, 10, 35, .78);
  --panel2: rgba(12, 6, 22, .92);

  --purple: #9b5cff;
  --violet: #b86cff;
  --pink: #ff4fd8;
  --pink2: #ff79e5;

  --white: #f8f2ff;
  --muted: #8e7b9f;
  --green: #63ffad;
  --yellow: #ffd45c;

  --border: rgba(184,108,255,.18);
  --glow: rgba(155,92,255,.28);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  color: var(--white);
  font-family: "Rajdhani", sans-serif;
  overflow-x: hidden;

  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(184,108,255,.22),
      transparent 35%
    ),
    radial-gradient(
      circle at 0% 50%,
      rgba(155,92,255,.10),
      transparent 32%
    ),
    radial-gradient(
      circle at 100% 70%,
      rgba(255,79,216,.08),
      transparent 30%
    ),
    linear-gradient(
      160deg,
      #05030a,
      #0b0613 48%,
      #05030a
    );
}

/* =========================
   BACKGROUND
========================= */

body::before {
  content: "";
  position: fixed;
  inset: 0;

  background-image:
    linear-gradient(
      rgba(184,108,255,.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(184,108,255,.025) 1px,
      transparent 1px
    );

  background-size: 45px 45px;
  pointer-events: none;
  z-index: 0;
}

body::after {
  content: "";
  position: fixed;
  inset: 0;

  background:
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 4px,
      rgba(255,255,255,.008) 5px
    );

  pointer-events: none;
  z-index: 0;
}

/* =========================
   MAIN CONTAINER
========================= */

.container {
  position: relative;
  z-index: 1;

  width: min(920px, calc(100% - 28px));
  margin: auto;

  padding: 20px 0 45px;
}

/* =========================
   HEADER
========================= */

.header {
  position: relative;
  text-align: center;

  padding: 45px 20px 32px;
  margin-bottom: 20px;

  border-radius: 28px;

  background:
    linear-gradient(
      145deg,
      rgba(30,14,48,.70),
      rgba(8,4,15,.55)
    );

  border: 1px solid rgba(184,108,255,.14);

  box-shadow:
    0 25px 80px rgba(0,0,0,.45),
    inset 0 1px rgba(255,255,255,.04);

  overflow: hidden;
}

.header::before {
  content: "";

  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;

  height: 2px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--purple),
      var(--pink),
      transparent
    );

  box-shadow:
    0 0 25px var(--purple);
}

.header::after {
  content: "";

  position: absolute;
  width: 220px;
  height: 220px;

  left: 50%;
  top: 20px;

  transform: translateX(-50%);

  background: rgba(155,92,255,.08);
  filter: blur(70px);

  pointer-events: none;
}

/* =========================
   BADGE
========================= */

.header-badge {
  position: relative;
  z-index: 2;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 8px 18px;

  border: 1px solid rgba(184,108,255,.30);
  border-radius: 999px;

  background: rgba(155,92,255,.06);

  color: #cfa8ff;

  font-family: "Share Tech Mono", monospace;
  font-size: 9px;
  letter-spacing: 3px;

  box-shadow:
    0 0 25px rgba(155,92,255,.08);

  animation: badgeGlow 3s ease-in-out infinite;
}

@keyframes badgeGlow {
  0%,100% {
    box-shadow:
      0 0 12px rgba(155,92,255,.08);
  }

  50% {
    box-shadow:
      0 0 28px rgba(255,79,216,.20);
  }
}

/* =========================
   TITLE
========================= */

.title {
  position: relative;
  z-index: 2;

  margin-top: 22px;

  font-family: "Orbitron", monospace;
  font-size: clamp(42px, 10vw, 82px);
  font-weight: 900;

  letter-spacing: 7px;
  line-height: .95;

  background:
    linear-gradient(
      120deg,
      #ffffff 0%,
      #e3c9ff 30%,
      var(--violet) 62%,
      var(--pink) 100%
    );

  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;

  filter:
    drop-shadow(0 0 20px rgba(184,108,255,.32));

  animation: titlePulse 4s ease-in-out infinite;
}

@keyframes titlePulse {
  0%,100% {
    filter:
      drop-shadow(0 0 18px rgba(184,108,255,.25));
  }

  50% {
    filter:
      drop-shadow(0 0 35px rgba(184,108,255,.60))
      drop-shadow(0 0 70px rgba(255,79,216,.16));
  }
}

.subtitle {
  position: relative;
  z-index: 2;

  margin-top: 15px;

  color: var(--muted);

  font-family: "Share Tech Mono", monospace;
  font-size: 11px;

  letter-spacing: 3px;
  text-transform: uppercase;
}

.header-line {
  width: 55%;
  height: 1px;

  margin: 28px auto 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--purple),
      var(--pink),
      transparent
    );

  box-shadow:
    0 0 18px rgba(184,108,255,.55);
}

/* =========================
   STATUS
========================= */

.status-bar {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 10px;

  margin: 18px 0;
}

.status-item {
  min-height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 10px;

  border-radius: 12px;

  background:
    rgba(18,8,29,.68);

  border: 1px solid rgba(184,108,255,.10);

  color: var(--muted);

  font-family: "Share Tech Mono", monospace;
  font-size: 9px;
  letter-spacing: 1px;
}

.status-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: var(--green);

  box-shadow:
    0 0 12px var(--green);

  animation: statusBlink 1.5s infinite;
}

.status-dot.red {
  background: #ff5c8a;
  box-shadow: 0 0 12px #ff5c8a;
}

.status-dot.yellow {
  background: var(--yellow);
  box-shadow: 0 0 12px var(--yellow);
}

@keyframes statusBlink {
  0%,100% { opacity: 1; }
  50% { opacity: .25; }
}

/* =========================
   MAIN PANEL
========================= */

.glass-panel {
  position: relative;
  overflow: hidden;

  margin-bottom: 22px;
  padding: 30px;

  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      rgba(29,14,46,.82),
      rgba(10,5,18,.90)
    );

  border: 1px solid var(--border);

  box-shadow:
    0 25px 70px rgba(0,0,0,.42),
    inset 0 1px rgba(255,255,255,.035);
}

.glass-panel::before {
  content: "";

  position: absolute;

  top: 0;
  left: 12%;
  right: 12%;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      var(--violet),
      var(--pink),
      transparent
    );
}

/* Decorative corners */

.corner-tl,
.corner-br {
  position: absolute;

  width: 25px;
  height: 25px;

  pointer-events: none;
}

.corner-tl {
  top: 12px;
  left: 12px;

  border-top: 2px solid var(--violet);
  border-left: 2px solid var(--violet);

  filter:
    drop-shadow(0 0 6px var(--violet));
}

.corner-br {
  right: 12px;
  bottom: 12px;

  border-right: 2px solid var(--pink);
  border-bottom: 2px solid var(--pink);

  filter:
    drop-shadow(0 0 6px var(--pink));
}

/* =========================
   PANEL LABEL
========================= */

.panel-label {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 27px;

  color: #c89aff;

  font-family: "Share Tech Mono", monospace;
  font-size: 10px;

  letter-spacing: 3px;
  text-transform: uppercase;
}

.panel-label::before {
  content: "◈";

  color: var(--pink);

  text-shadow:
    0 0 10px var(--pink);
}

.panel-label::after {
  content: "";

  flex: 1;

  height: 1px;

  background:
    linear-gradient(
      90deg,
      rgba(184,108,255,.25),
      transparent
    );
}

/* =========================
   FIELDS
========================= */

.field-group {
  margin-bottom: 25px;
}

.field-label {
  display: block;

  margin-bottom: 10px;

  color: #b995e0;

  font-family: "Share Tech Mono", monospace;
  font-size: 10px;

  letter-spacing: 2px;
  text-transform: uppercase;
}

.field-input {
  width: 100%;

  padding: 15px 17px;

  border-radius: 13px;

  color: #f1dcff;

  background:
    rgba(4,2,9,.82);

  border: 1px solid rgba(184,108,255,.15);

  outline: none;

  font-family: "Share Tech Mono", monospace;
  font-size: 13px;

  transition: .3s ease;
}

.field-input:hover {
  border-color: rgba(184,108,255,.25);
}

.field-input:focus {
  border-color: var(--violet);

  box-shadow:
    0 0 0 3px rgba(155,92,255,.06),
    0 0 30px rgba(155,92,255,.15);
}

.field-input::placeholder {
  color: rgba(142,123,159,.40);
}

/* =========================
   SLIDER
========================= */

.slider-row {
  display: flex;
  align-items: center;

  gap: 14px;
}

.slider-wrap {
  flex: 1;
}

input[type="range"] {
  width: 100%;
  height: 6px;

  appearance: none;
  -webkit-appearance: none;

  border-radius: 20px;

  background:
    linear-gradient(
      90deg,
      var(--purple),
      var(--pink)
    );

  outline: none;
}

input[type="range"]::-webkit-slider-thumb {
  appearance: none;
  -webkit-appearance: none;

  width: 21px;
  height: 21px;

  border-radius: 50%;

  background: #ffffff;

  border: 4px solid var(--violet);

  box-shadow:
    0 0 12px var(--violet),
    0 0 28px rgba(255,79,216,.35);

  cursor: pointer;
}

.number-input {
  width: 92px;

  text-align: center;

  font-weight: 700;
}

/* =========================
   PROGRESS
========================= */

.progress-wrap {
  display: none;

  margin-top: 20px;

  padding: 14px;

  border-radius: 14px;

  background:
    rgba(5,2,11,.55);

  border: 1px solid rgba(184,108,255,.10);
}

.progress-wrap.active {
  display: block;
}

.progress-header {
  display: flex;
  justify-content: space-between;

  margin-bottom: 9px;

  color: #cdaaff;

  font-family: "Share Tech Mono", monospace;
  font-size: 10px;
}

.progress-track {
  height: 8px;

  overflow: hidden;

  border-radius: 20px;

  background:
    rgba(255,255,255,.035);

  border: 1px solid rgba(184,108,255,.12);
}

.progress-fill {
  position: relative;

  width: 0%;
  height: 100%;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      var(--purple),
      var(--violet),
      var(--pink)
    );

  box-shadow:
    0 0 18px rgba(184,108,255,.75);

  transition:
    width .3s linear;
}

.progress-fill::after {
  content: "";

  position: absolute;

  top: 0;
  right: 0;

  width: 45px;
  height: 100%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(255,255,255,.75)
    );

  animation: progressShine .8s infinite;
}

@keyframes progressShine {
  0% { opacity: 0; }
  50% { opacity: 1; }
  100% { opacity: 0; }
}

/* =========================
   BUTTON AREA
========================= */

.btn-row {
  display: grid;

  grid-template-columns:
    1fr 170px;

  gap: 12px;

  margin-top: 20px;
}

.btn-execute {
  min-height: 54px;

  border: none;
  border-radius: 14px;

  color: white;

  background:
    linear-gradient(
      110deg,
      #713bdb,
      #a84fe6,
      #e54fc9
    );

  font-family: "Orbitron", monospace;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: 1.5px;

  cursor: pointer;

  box-shadow:
    0 12px 35px rgba(155,92,255,.22);

  transition: .25s ease;
}

.btn-execute:hover {
  transform: translateY(-3px);

  box-shadow:
    0 16px 45px rgba(196,92,255,.42);
}

.btn-execute:active {
  transform: scale(.97);
}

.btn-execute.running {
  animation: buttonPulse .8s infinite;
}

@keyframes buttonPulse {
  0%,100% {
    box-shadow:
      0 0 18px rgba(196,92,255,.35);
  }

  50% {
    box-shadow:
      0 0 45px rgba(255,79,216,.65);
  }
}

.btn-reset {
  min-height: 54px;

  border-radius: 14px;

  color: #9d8aaa;

  background:
    rgba(17,8,28,.75);

  border: 1px solid rgba(184,108,255,.14);

  font-family: "Share Tech Mono", monospace;

  font-size: 11px;

  cursor: pointer;

  transition: .25s ease;
}

.btn-reset:hover {
  color: #d8b9f5;

  border-color:
    rgba(184,108,255,.40);

  box-shadow:
    0 0 25px rgba(155,92,255,.12);
}

/* =========================
   TERMINAL
========================= */

.terminal-wrap {
  position: relative;

  padding: 0 !important;

  background: transparent !important;

  border: none !important;

  box-shadow: none !important;
}

.terminal-titlebar {
  display: flex;
  align-items: center;

  gap: 8px;

  padding: 14px 17px;

  background:
    rgba(7,3,13,.96);

  border:
    1px solid rgba(184,108,255,.15);

  border-bottom: none;

  border-radius: 17px 17px 0 0;
}

.dot {
  width: 10px;
  height: 10px;

  border-radius: 50%;
}

.dot.r { background: #ff5f56; }
.dot.y { background: #ffbd2e; }
.dot.g { background: #27c93f; }

.terminal-title {
  margin-left: 7px;

  color: #907b9e;

  font-family: "Share Tech Mono", monospace;
  font-size: 10px;

  letter-spacing: 2px;
}

.terminal {
  height: 340px;

  overflow-y: auto;

  padding: 20px;

  background:
    radial-gradient(
      circle at 90% 0%,
      rgba(155,92,255,.07),
      transparent 35%
    ),
    #030207;

  border:
    1px solid rgba(184,108,255,.15);

  border-radius: 0 0 17px 17px;

  color: var(--green);

  font-family: "Share Tech Mono", monospace;
  font-size: 12px;

  line-height: 1.8;

  box-shadow:
    0 25px 60px rgba(0,0,0,.45);
}

.terminal::-webkit-scrollbar {
  width: 4px;
}

.terminal::-webkit-scrollbar-track {
  background: transparent;
}

.terminal::-webkit-scrollbar-thumb {
  background:
    rgba(184,108,255,.25);

  border-radius: 20px;
}

.log-line {
  opacity: 0;

  transform: translateX(-6px);

  animation:
    logAppear .3s forwards;
}

@keyframes logAppear {
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.log-ok {
  color: var(--green);
}

.log-info {
  color: #d18cff;
}

.log-warn {
  color: var(--yellow);
}

.log-err {
  color: #ff6b91;
}

.log-dim {
  color: #765f8b;
}

.log-sys {
  color: #b28cff;
}

.cursor-blink {
  display: inline-block;

  width: 7px;
  height: 13px;

  margin-left: 3px;

  vertical-align: middle;

  background:
    var(--green);

  animation:
    cursorBlink .8s step-end infinite;
}

@keyframes cursorBlink {
  0%,100% { opacity: 1; }
  50% { opacity: 0; }
}

/* =========================
   FEATURE CARDS
========================= */

.feature-grid {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 13px;

  margin: 22px 0;
}

.feature-card {
  position: relative;

  padding: 20px;

  min-height: 135px;

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      rgba(29,14,46,.68),
      rgba(9,5,16,.82)
    );

  border:
    1px solid rgba(184,108,255,.12);

  transition: .3s ease;
}

.feature-card:hover {
  transform: translateY(-4px);

  border-color:
    rgba(184,108,255,.32);

  box-shadow:
    0 15px 35px rgba(0,0,0,.25),
    0 0 25px rgba(155,92,255,.08);
}

.feature-icon {
  margin-bottom: 12px;

  color: var(--violet);

  font-size: 20px;

  text-shadow:
    0 0 12px var(--violet);
}

.feature-title {
  margin-bottom: 7px;

  color: #ead8ff;

  font-family: "Orbitron", monospace;
  font-size: 10px;

  letter-spacing: 1px;
}

.feature-text {
  color: var(--muted);

  font-size: 11px;

  line-height: 1.5;
}

/* =========================
   LINKS
========================= */

.links-section {
  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 12px;

  margin: 24px 0;
}

.link-btn {
  min-height: 54px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  border-radius: 14px;

  text-decoration: none;

  font-family: "Rajdhani", sans-serif;

  font-size: 14px;
  font-weight: 700;

  letter-spacing: 1px;

  transition: .3s ease;
}

.link-btn svg {
  width: 20px !important;
  height: 20px !important;

  min-width: 20px !important;
  max-width: 20px !important;

  display: block;
}

.link-btn-wa {
  color: #55e88a;

  background:
    linear-gradient(
      135deg,
      rgba(37,211,102,.07),
      rgba(37,211,102,.025)
    );

  border:
    1px solid rgba(37,211,102,.18);
}

.link-btn-wa:hover {
  transform: translateY(-3px);

  background:
    rgba(37,211,102,.11);

  box-shadow:
    0 12px 30px rgba(37,211,102,.10);
}

.link-btn-tg {
  color: #62caff;

  background:
    linear-gradient(
      135deg,
      rgba(41,169,224,.07),
      rgba(41,169,224,.025)
    );

  border:
    1px solid rgba(41,169,224,.18);
}

.link-btn-tg:hover {
  transform: translateY(-3px);

  background:
    rgba(41,169,224,.11);

  box-shadow:
    0 12px 30px rgba(41,169,224,.10);
}

/* =========================
   FOOTER
========================= */

.footer {
  position: relative;

  padding: 22px 10px 8px;

  text-align: center;

  color: #756480;

  font-family: "Share Tech Mono", monospace;

  font-size: 9px;

  letter-spacing: 2px;
}

.footer::before {
  content: "";

  display: block;

  width: 70%;
  height: 1px;

  margin: 0 auto 17px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(184,108,255,.30),
      rgba(255,79,216,.25),
      transparent
    );
}

.footer span {
  color: var(--violet);

  text-shadow:
    0 0 12px rgba(184,108,255,.55);
}

/* =========================
   MOBILE
========================= */

@media (max-width: 700px) {

  .container {
    width: calc(100% - 20px);
    padding-top: 10px;
  }

  .header {
    padding: 38px 14px 28px;

    border-radius: 22px;
  }

  .header-badge {
    font-size: 8px;
    letter-spacing: 2px;
  }

  .title {
    font-size: clamp(38px, 13vw, 58px);
    letter-spacing: 4px;
  }

  .subtitle {
    font-size: 9px;
    letter-spacing: 2px;
  }

  .header-line {
    width: 85%;
  }

  .status-bar {
    grid-template-columns: 1fr;
  }

  .status-item {
    justify-content: flex-start;
    padding-left: 15px;
  }

  .glass-panel {
    padding: 20px 16px;

    border-radius: 19px;
  }

  .btn-row {
    grid-template-columns: 1fr;
  }

  .btn-execute,
  .btn-reset {
    width: 100%;
  }

  .slider-row {
    flex-direction: column;
    align-items: stretch;
  }

  .number-input {
    width: 100%;
  }

  .terminal {
    height: 310px;
    padding: 16px;
    font-size: 11px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }

  .feature-card {
    min-height: auto;
  }

  .links-section {
    grid-template-columns: 1fr;
  }

  .link-btn {
    width: 100%;
  }

  .footer {
    font-size: 8px;
    letter-spacing: 1px;
  }
}
</style>
</head>
<body>

<div class="container">

  <!-- HEADER -->
  <header class="header">

    <div class="header-badge">
       ʙᴏᴏᴍʙᴀʀ sɪᴛᴇ
    </div>

    <h1 class="title">
      KAIRO DEV
    </h1>

    <p class="subtitle">
     KAIRO BOOMBAR &amp; CONTROL SYSTEM
    </p>

    <div class="header-line"></div>

  </header>


  <!-- STATUS BAR -->
  <div class="status-bar">

    <div class="status-item">
