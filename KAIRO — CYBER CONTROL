<script>
// ── CLOCK ──
function updateClock() {
  const now = new Date();
  document.getElementById('clock').textContent =
    now.toISOString().replace('T',' ').slice(0,19) + ' UTC';
}
updateClock(); setInterval(updateClock, 1000);

// ── SLIDER <-> NUMBER SYNC ──
const slider = document.getElementById('levelSlider');
const numInput = document.getElementById('levelNumber');
slider.addEventListener('input', () => { numInput.value = slider.value; });
numInput.addEventListener('input', () => {
  let v = parseInt(numInput.value) || 300;
  v = Math.min(1000, Math.max(100, v));
  slider.value = v; numInput.value = v;
});

// ── TERMINAL UTILS ──
const terminal = document.getElementById('terminal');
let running = false;

function appendLog(text, cls = 'log-ok', delay = 0) {
  return new Promise(res => setTimeout(() => {
    const line = document.createElement('div');
    line.className = `log-line ${cls}`;
    line.innerHTML = text;
    terminal.appendChild(line);
    terminal.scrollTop = terminal.scrollHeight;
    res();
  }, delay));
}

function clearTerminal() {
  terminal.innerHTML = '';
  appendLog('// Terminal cleared.', 'log-dim');
  appendLog('root@boombar:~$ <span class="cursor-blink"></span>', 'log-sys');
}

function resetTerminal() {
  if (running) return;
  clearTerminal();
  document.getElementById('progressWrap').classList.remove('active');
}

// ── PROGRESS BAR ──
function setProgress(pct, label) {
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressPct').textContent = Math.round(pct) + '%';
  if (label) document.getElementById('progressLabel').textContent = label;
}

// ── SIMULATION LOGS ──
function randHex(n) {
  return [...Array(n)].map(() => Math.floor(Math.random()*16).toString(16)).join('');
}
function randIp() {
  return `${(Math.random()*254|0)+1}.${Math.random()*254|0}.${Math.random()*254|0}.${Math.random()*254|0}`;
}
function randPort() { return (Math.random()*64511+1024|0); }
function randMs()   { return (Math.random()*300+10).toFixed(2); }
function randSize() { return (Math.random()*4096+64|0); }

async function runSimulation() {
  if (running) return;
  const target = document.getElementById('targetInput').value.trim() || 'UNKNOWN_TARGET';
  const level  = parseInt(slider.value);
  const btn    = document.getElementById('executeBtn');
  running = true;
  btn.classList.add('running');
  btn.textContent = '⏳ EXECUTING...';

  const pw = document.getElementById('progressWrap');
  pw.classList.add('active');
  setProgress(0, 'INITIALIZING...');

  terminal.innerHTML = '';
  const ts = () => `[${new Date().toISOString().slice(11,23)}]`;

  // Phase 1 – Init
  await appendLog(`${ts()} <span class="log-sys">root@boombar:~$</span> boombar --target "${target}" --level ${level}`, 'log-sys');
  await appendLog(`${ts()} <span class="log-info">◈ BOOMBAR Engine v3.7.2 initializing...</span>`, 'log-info', 200);
  await appendLog(`${ts()} Loading kernel modules... [OK]`, 'log-ok', 300);
  await appendLog(`${ts()} Binding raw socket interface... [OK]`, 'log-ok', 400);
  setProgress(5, 'LOADING MODULES...');

  await appendLog(`${ts()} <span class="log-warn">⚠ Target lock: <b>${target}</b></span>`, 'log-warn', 500);
  await appendLog(`${ts()} Resolving target identifier... ${randHex(16).toUpperCase()}`, 'log-dim', 700);
  await appendLog(`${ts()} Session token: 0x${randHex(32).toUpperCase()}`, 'log-dim', 850);
  setProgress(12, 'RESOLVING TARGET...');

  // Phase 2 – Scan
  await appendLog(`${ts()} <span class="log-info">▶ Starting environment scan...</span>`, 'log-info', 1000);
  const ports = [22,80,443,3306,6379,8080,8443,27017];
  for (let i = 0; i < ports.length; i++) {
    const state = Math.random() > 0.35 ? '<span class="log-ok">OPEN</span>' : '<span class="log-err">CLOSED</span>';
    await appendLog(`${ts()} PORT ${String(ports[i]).padEnd(5)} → ${state} (${randMs()}ms)`, 'log-dim', 1100 + i*130);
    setProgress(12 + i*3, 'PORT SCANNING...');
  }

  await appendLog(`${ts()} Network topology mapped. Gateway: ${randIp()}`, 'log-dim', 2300);
  await appendLog(`${ts()} MTU: 1500 | Hop count: ${3+Math.random()*8|0} | RTT: ${randMs()}ms`, 'log-dim', 2500);
  setProgress(40, 'MAPPING TOPOLOGY...');

  // Phase 3 – Explosions d'installation
  await appendLog(`${ts()} <span class="log-info">◈ Lancement des explosions d'installation — niveau ${level}...</span>`, 'log-info', 2700);
  const batches = 6;
  const batchSize = Math.ceil(level / batches);
  const totalDuration = (level * 0.012).toFixed(1); // durée simulée en secondes

  for (let b = 0; b < batches; b++) {
    const exploded = Math.min((b + 1) * batchSize, level);
    const remaining = level - exploded;
    const timeLeft = ((remaining / level) * totalDuration).toFixed(1);
    const src = randIp(); const dst = randIp();
    const proto = ['TCP','UDP','ICMP','HTTP/2','TLS1.3'][Math.floor(Math.random()*5)];

    // Ligne explosion principale
    await appendLog(
      `${ts()} ??🔴⚡<span style="color:#ff6622;font-weight:bold">explosion d'installation</span> — ${proto} ${src}:${randPort()} → ${dst}:${randPort()} | seq:0x${randHex(8)}`,
      'log-warn',
      2900 + b * 380
    );
    // Ligne compteur + durée restante
    await appendLog(
      `${ts()} &nbsp;&nbsp;&nbsp;↳ <span class="log-ok">${exploded}/${level} explosions</span> effectuées · durée restante : <span class="log-info">${timeLeft}s</span>`,
      'log-dim',
      2900 + b * 380 + 160
    );
    setProgress(40 + b * 8, `EXPLOSIONS... [${exploded}/${level}]`);
  }

  await appendLog(`${ts()} ?🔴⚡ <span style="color:#00ff88;font-weight:bold">Toutes les explosions d'installation terminées !</span> — ${level}/${level}`, 'log-ok', 5100);
  await appendLog(`${ts()} Buffer flush: ${level} paquets traités, 0 perdus`, 'log-ok', 5300);
  setProgress(85, 'FLUSHING BUFFERS...');

  // Phase 4 – Analysis
  await appendLog(`${ts()} <span class="log-info">▶ Running payload integrity check...</span>`, 'log-info', 5400);
  await appendLog(`${ts()} CRC-32: 0x${randHex(8).toUpperCase()} — VALID`, 'log-ok', 5700);
  await appendLog(`${ts()} SHA-256: ${randHex(64).toUpperCase()}`, 'log-dim', 5900);
  await appendLog(`${ts()} Entropy analysis: ${(Math.random()*1.5+6.5).toFixed(4)} bits/byte`, 'log-dim', 6100);
  setProgress(93, 'INTEGRITY CHECK...');

  await appendLog(`${ts()} <span class="log-warn">⚡ Simulation throughput: ${(Math.random()*800+200).toFixed(1)} Mbps</span>`, 'log-warn', 6400);
  await appendLog(`${ts()} CPU utilization peak: ${(Math.random()*40+50).toFixed(1)}%`, 'log-dim', 6600);
  await appendLog(`${ts()} Memory consumed: ${(Math.random()*300+100).toFixed(0)} MB`, 'log-dim', 6800);
  setProgress(97, 'FINALIZING...');

  // Phase 5 – Complete
  await appendLog(`${ts()} ────────────────────────────────────────────`, 'log-dim', 7100);
  await appendLog(`${ts()} <span style="color:#00ff88;font-weight:bold">✓ SIMULATION COMPLETE — TARGET: ${target} | LEVEL: ${level}</span>`, 'log-ok', 7200);
  await appendLog(`${ts()} Total time: ${(Math.random()*2+5).toFixed(3)}s | Status: <span class="log-ok">SUCCESS</span>`, 'log-ok', 7400);
  await appendLog(`${ts()} Teardown complete. All sockets released.`, 'log-dim', 7600);
  await appendLog(`${ts()} <span class="log-sys">root@boombar:~$</span> <span class="cursor-blink"></span>`, 'log-sys', 7800);
  setProgress(100, 'COMPLETED ✓');

  btn.textContent = '✓ COMPLETED';
  setTimeout(() => {
    btn.classList.remove('running');
    btn.textContent = '⚡ EXECUTE GENERATION';
    running = false;
  }, 2500);
}
</script>
